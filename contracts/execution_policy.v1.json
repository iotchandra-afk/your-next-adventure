{
  "schema_version": 1,
  "project": "YourNextAdventure",
  "mode": "AUTONOMOUS_EXECUTION",
  "implementation_authority_source": "SPEC_MANIFEST.json",
  "default_action": "CONTINUE",
  "communication_default": "SILENT",
  "decision_rule": "if task_incomplete and no_blocker and no_approval_boundary and no_human_action and execution_surface_active then CONTINUE",
  "execution_surface": {
    "ordinary_chat_role": "STEERING_AND_EXCEPTIONS_ONLY",
    "persistent_execution_required_for_cross_response_continuation": true,
    "github_is_control_plane_not_execution_plane": true,
    "repository_policy_does_not_create_chat_persistence": true,
    "acceptable_persistent_surface_examples": [
      "CHATGPT_WORK",
      "REPOSITORY_NATIVE_AGENT",
      "DURABLE_AUTOMATION_WORKER"
    ],
    "forbid_claiming_background_continuation_without_active_runner": true,
    "persistent_runner_must_continue_across_internal_engineering_units": true
  },
  "stop_conditions": [
    "BLOCKED",
    "APPROVAL_REQUIRED",
    "HUMAN_ACTION_REQUIRED",
    "DONE"
  ],
  "approval_boundaries": [
    "NEW_MATERIAL_PAID_SERVICE",
    "DESTRUCTIVE_PRODUCTION_OPERATION",
    "SECURITY_BOUNDARY_CHANGE",
    "OUTBOUND_COMMUNICATION_SEND",
    "FINAL_JOB_APPLICATION_SUBMISSION"
  ],
  "merge_deploy_policy": {
    "production_label_alone_requires_approval": false,
    "routine_reversible_merge_to_main_requires_approval": false,
    "routine_reversible_deployment_requires_approval": false,
    "github_pages_deployment_requires_approval": false,
    "additive_non_destructive_migration_requires_approval": false,
    "pr_ready_is_completion": false,
    "ci_passed_is_completion": false,
    "deployment_ready_is_completion": false,
    "requirements_for_autonomous_merge_deploy": [
      "WITHIN_ALREADY_AUTHORIZED_SCOPE",
      "REQUIRED_CHECKS_PASS",
      "NO_RESERVED_BOUNDARY_CHANGE",
      "NORMAL_ROLLBACK_PATH_EXISTS"
    ],
    "on_base_branch_drift": [
      "UPDATE_OR_REBASE_BRANCH",
      "RESOLVE_ROUTINE_CONFLICTS",
      "RERUN_REQUIRED_CHECKS",
      "MERGE_WHEN_SAFE",
      "VERIFY_DEPLOYMENT",
      "CONTINUE"
    ]
  },
  "routine_autonomous_actions": [
    "UPDATE_OR_REBASE_IMPLEMENTATION_BRANCH",
    "RESOLVE_ROUTINE_NON_CONSEQUENTIAL_MERGE_CONFLICTS",
    "MERGE_IMPLEMENTATION_PR_TO_MAIN",
    "SQUASH_MERGE_IMPLEMENTATION_PR_TO_MAIN",
    "GITHUB_PAGES_DEPLOYMENT_FROM_MAIN",
    "VERIFY_ROUTINE_DEPLOYMENT",
    "ADDITIVE_NON_DESTRUCTIVE_SCHEMA_MIGRATION"
  ],
  "forbidden_unsolicited_interruptions": [
    "PROGRESS_UPDATE",
    "PERCENT_COMPLETE",
    "CHECKPOINT_PASS",
    "SUCCESSFUL_TEST",
    "SUCCESSFUL_DEPLOYMENT",
    "SUCCESSFUL_MIGRATION",
    "PR_READY_FOR_REVIEW",
    "PR_READY_FOR_MERGE",
    "ROUTINE_MERGE_APPROVAL_REQUEST",
    "ROUTINE_DEPLOYMENT_APPROVAL_REQUEST",
    "ROUTINE_IMPLEMENTATION_CHOICE",
    "RECOVERABLE_FAILURE",
    "DEBUGGING_PROGRESS",
    "SOURCE_SYNC_STATUS",
    "MODEL_RUN_STATUS",
    "REQUEST_TO_PROCEED",
    "REQUEST_TO_RECONFIRM_EXISTING_AUTHORITY"
  ],
  "checkpoint_behavior": {
    "on_pass": [
      "VERIFY",
      "PERSIST_EVIDENCE",
      "PERFORM_NEXT_SAFE_AUTHORIZED_ACTION",
      "CONTINUE_IF_EXECUTION_SURFACE_ACTIVE"
    ],
    "requires_user_acknowledgement": false,
    "emit_status_message": false
  },
  "completion_policy": {
    "code_written_is_done": false,
    "pr_opened_is_done": false,
    "pr_ready_is_done": false,
    "ci_passed_is_done": false,
    "deployment_ready_is_done": false,
    "checkpoint_reached_is_done": false,
    "done_requires_active_task_acceptance_criteria_satisfied": true
  },
  "failure_behavior": {
    "recoverable_failure": "REMEDIATE_AND_CONTINUE",
    "consequential_unknown": "FAIL_CLOSED",
    "escalate_only_if_stop_condition": true,
    "bundle_unresolved_questions": true,
    "base_branch_drift": "REPAIR_AND_CONTINUE"
  },
  "user_requested_query_behavior": {
    "answer_direct_question": true,
    "request_permission_to_resume_after_answer": false,
    "claim_cross_response_continuation_in_ordinary_chat": false
  },
  "allowed_unsolicited_message_prefixes": [
    "BLOCKED",
    "APPROVAL REQUIRED",
    "HUMAN ACTION REQUIRED",
    "DONE"
  ],
  "control_plane": {
    "product_contract": "SPEC.md",
    "agent_contract": "AGENTS.md",
    "manifest": "SPEC_MANIFEST.json",
    "checkpoint_evidence": "GitHub issue/control board",
    "runtime_state": "PostgreSQL/Supabase",
    "verification": "CI/evals"
  }
}
