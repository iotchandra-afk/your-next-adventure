{
  "schema_version": 1,
  "project": "YourNextAdventure",
  "mode": "AUTONOMOUS_EXECUTION",
  "implementation_authority_source": "SPEC_MANIFEST.json",
  "scope_authority_contract": "contracts/scope_authority.v1.json",
  "default_action": "CONTINUE",
  "communication_default": "SILENT",
  "decision_rule": "if task_incomplete and no_blocker and no_approval_boundary and no_human_action and execution_surface_active then CONTINUE",
  "scope_authority": {
    "precedence": [
      "PLATFORM_SYSTEM_SAFETY_AND_PERMISSION_CONSTRAINTS",
      "CURRENT_MAIN_NORMATIVE_CONTRACTS",
      "CURRENT_OPEN_P0_P1_ISSUES_AND_GO_LIVE_CONTROL_BOARD",
      "CURRENT_RUNTIME_EVIDENCE_REOPENING_OR_FALSIFYING_PRIOR_PASS",
      "ACTIVE_IMPLEMENTATION_PRS_AND_BRANCHES",
      "CLOSED_MERGED_PRS_CLOSED_ISSUES_AND_HISTORICAL_SUMMARIES"
    ],
    "historical_artifacts_are_scope_authority": false,
    "closed_merged_pr_may_override_current_main": false,
    "current_open_issue_may_supersede_prior_completion_statement": true,
    "stale_historical_conflict_requires_user_approval": false,
    "on_stale_historical_conflict": "USE_CURRENT_HIGHER_PRECEDENCE_AUTHORITY_AND_CONTINUE_UNLESS_TRUE_RESERVED_BOUNDARY_OR_PLATFORM_POLICY_BLOCKS",
    "issue_7_explicitly_authorized_actions": [
      "PROVIDER_DIAGNOSTICS_AND_TELEMETRY",
      "CIRCUIT_BREAKER_AND_BACKPRESSURE_LOGIC",
      "ADDITIVE_NON_DESTRUCTIVE_SUPABASE_MIGRATION",
      "STALE_WORK_RECOVERY",
      "DURABLE_WORKER_STATE_REPAIR",
      "COMMIT_AND_PUSH",
      "CREATE_OR_UPDATE_BRANCH_OR_PR",
      "MERGE_AND_DEPLOY",
      "CONTROL_PLANE_EVIDENCE_WRITE",
      "RUNTIME_RECONCILIATION",
      "RETRY_ROLL_FORWARD_OR_SAFE_ROLLBACK"
    ]
  },
  "execution_surface": {
    "ordinary_chat_role": "STEERING_AND_EXCEPTIONS_ONLY",
    "persistent_execution_required_for_cross_response_continuation": true,
    "github_is_control_plane_not_execution_plane": true,
    "repository_policy_does_not_create_chat_persistence": true,
    "acceptable_persistent_surface_examples": [
      "CHATGPT_WORK",
      "REPOSITORY_NATIVE_AGENT",
      "DURABLE_AUTOMATION_WORKER"
    ],
    "forbid_claiming_background_continuation_without_active_runner": true,
    "persistent_runner_must_continue_across_internal_engineering_units": true
  },
  "stop_conditions": [
    "BLOCKED",
    "APPROVAL_REQUIRED",
    "HUMAN ACTION REQUIRED",
    "DONE"
  ],
  "approval_boundaries": [
    "NEW_MATERIAL_PAID_SERVICE",
    "DESTRUCTIVE_PRODUCTION_OPERATION",
    "SECURITY_BOUNDARY_CHANGE",
    "OUTBOUND_COMMUNICATION_SEND",
    "FINAL_JOB_APPLICATION_SUBMISSION"
  ],
  "outbound_communication_policy": {
    "definition": "HUMAN_FACING_COMMUNICATION_TO_PERSON_OR_EXTERNAL_AUDIENCE_OUTSIDE_PROJECT_CONTROL_PLANE",
    "requires_approval": true,
    "approval_required_examples": [
      "EMAIL_TO_EXTERNAL_PERSON",
      "LINKEDIN_OR_SOCIAL_MESSAGE_TO_EXTERNAL_PERSON",
      "SLACK_WHATSAPP_SMS_TO_EXTERNAL_PERSON",
      "PUBLIC_SOCIAL_POST_PRESENTING_CANDIDATE",
      "EMPLOYER_APPLICATION_FREE_TEXT_SEND",
      "OTHER_EXTERNAL_CANDIDATE_REPRESENTATION"
    ],
    "project_control_plane_writes_are_outbound_communication": false,
    "autonomous_control_plane_examples": [
      "CREATE_GITHUB_PULL_REQUEST",
      "UPDATE_GITHUB_PULL_REQUEST_TITLE_OR_BODY",
      "CREATE_OR_UPDATE_GITHUB_ISSUE",
      "POST_GITHUB_ISSUE_OR_PR_CONTROL_PLANE_COMMENT",
      "PERSIST_CHECKPOINT_OR_VERIFICATION_EVIDENCE",
      "UPDATE_GO_LIVE_CONTROL_BOARD",
      "CREATE_REPOSITORY_COMMIT_BRANCH_OR_TAG",
      "COMMIT_AND_PUSH_AUTHORIZED_IMPLEMENTATION",
      "WRITE_AUTHORIZED_PROJECT_RUNTIME_EVIDENCE_TO_SUPABASE"
    ],
    "constraints_on_autonomous_control_plane_writes": [
      "WITHIN_ALREADY_AUTHORIZED_SCOPE",
      "NO_PRIVATE_CANDIDATE_DATA_OR_SECRETS_IN_PUBLIC_REPO",
      "NO_OTHER_RESERVED_APPROVAL_BOUNDARY_CROSSED"
    ]
  },
  "merge_deploy_policy": {
    "production_label_alone_requires_approval": false,
    "routine_reversible_merge_to_main_requires_approval": false,
    "routine_reversible_deployment_requires_approval": false,
    "github_pages_deployment_requires_approval": false,
    "additive_non_destructive_migration_requires_approval": false,
    "pr_ready_is_completion": false,
    "ci_passed_is_completion": false,
    "deployment_ready_is_completion": false,
    "requirements_for_autonomous_merge_deploy": [
      "WITHIN_ALREADY_AUTHORIZED_SCOPE",
      "REQUIRED_CHECKS_PASS",
      "AFFECTED_PRODUCT_INVARIANTS_PASS",
      "NO_RESERVED_BOUNDARY_CHANGE",
      "NORMAL_ROLLBACK_PATH_EXISTS"
    ],
    "on_base_branch_drift": [
      "UPDATE_OR_REBASE_BRANCH",
      "RESOLVE_ROUTINE_CONFLICTS",
      "RERUN_REQUIRED_CHECKS",
      "MERGE_WHEN_SAFE",
      "VERIFY_DEPLOYMENT",
      "CONTINUE"
    ]
  },
  "delivery_assurance_policy": {
    "contract": "docs/DELIVERY_ASSURANCE_CONTRACT.md",
    "product_invariants": "contracts/product_invariants.v1.json",
    "enabled_for_material_changes": true,
    "change_impact_map_required": true,
    "positive_assertions_required": true,
    "negative_assertions_required": true,
    "state_transition_verification_required_when_applicable": true,
    "runtime_capacity_verification_required_for_model_workflows": true,
    "runtime_reconciliation_required_when_applicable": true,
    "deployed_verification_required_for_user_visible_changes": true,
    "prior_pass_auto_falsified_by_contradictory_evidence": true,
    "autonomous_repair_retry_or_safe_rollback_before_escalation": true,
    "semantic_truth": {
      "null_may_become_substantive_business_outcome": false,
      "ui_may_invent_business_decision_for_display": false,
      "labels_must_match_backing_query_state": true,
      "incomplete_processing_may_be_presented_as_completed_zero": false
    },
    "runtime_backpressure": {
      "shared_per_model_capacity_required": true,
      "workflow_concurrency_must_align_to_model": true,
      "in_process_parallelism_must_obey_capacity": true,
      "provider_429_must_trigger_backpressure_not_retry_storm": true,
      "stale_running_work_must_be_recoverable": true,
      "backlog_count_and_oldest_age_must_be_observable": true
    },
    "verification_ladder": [
      "CONTRACT_STATIC_CHECKS",
      "UNIT_TESTS",
      "STATE_TRANSITION_TESTS",
      "GOLDEN_ADVERSARIAL_EVALS",
      "RUNTIME_SMOKE",
      "DEPLOYED_PRODUCT_VERIFICATION",
      "POST_DEPLOY_RUNTIME_RECONCILIATION"
    ]
  },
  "iteration_policy": {
    "contract": "docs/ITERATION_CONTRACT.md",
    "enabled_for_persistent_runs": true,
    "after_material_slice": "REITERATE",
    "reiterate_is_user_facing_message": false,
    "scope_for_next_iteration": "ENTIRE_AUTHORIZED_PRODUCT_SCOPE",
    "prior_passes_are_falsifiable": true,
    "reopen_checkpoint_when_new_evidence_invalidates_pass": true,
    "whole_system_red_team_required": true,
    "real_data_verification_required_when_feasible": true,
    "deployed_behavior_required_for_user_visible_acceptance": true,
    "forbid_weakening_requirements_to_reach_done": true,
    "forbid_proxy_metric_substitution_for_required_outcome": true,
    "forbid_local_optimization_at_product_objective_expense": true,
    "priority_order": [
      "MISSED_HIGH_VALUE_OPPORTUNITIES",
      "MATERIALLY_WRONG_DECISIONS",
      "USER_VALIDATION_OR_ACTION_DEAD_ENDS",
      "TRUTH_PROVENANCE_SECURITY_FAILURES",
      "RELIABILITY_RECOVERY_COST_FAILURES",
      "DECISION_VELOCITY_USABILITY",
      "COSMETIC_REFINEMENT"
    ]
  },
  "routine_autonomous_actions": [
    "CREATE_GITHUB_PULL_REQUEST",
    "UPDATE_GITHUB_PULL_REQUEST_TITLE_OR_BODY",
    "CREATE_OR_UPDATE_GITHUB_ISSUE",
    "POST_GITHUB_CONTROL_PLANE_COMMENT",
    "PERSIST_CHECKPOINT_OR_VERIFICATION_EVIDENCE",
    "UPDATE_GO_LIVE_CONTROL_BOARD",
    "COMMIT_AND_PUSH_AUTHORIZED_IMPLEMENTATION",
    "UPDATE_OR_REBASE_IMPLEMENTATION_BRANCH",
    "RESOLVE_ROUTINE_NON_CONSEQUENTIAL_MERGE_CONFLICTS",
    "MERGE_IMPLEMENTATION_PR_TO_MAIN",
    "SQUASH_MERGE_IMPLEMENTATION_PR_TO_MAIN",
    "GITHUB_PAGES_DEPLOYMENT_FROM_MAIN",
    "VERIFY_ROUTINE_DEPLOYMENT",
    "ADDITIVE_NON_DESTRUCTIVE_SCHEMA_MIGRATION",
    "PROVIDER_DIAGNOSTICS_AND_TELEMETRY",
    "CIRCUIT_BREAKER_AND_BACKPRESSURE_LOGIC",
    "BUILD_CHANGE_IMPACT_MAP",
    "VERIFY_AFFECTED_PRODUCT_INVARIANTS",
    "RUN_NEGATIVE_ASSERTIONS",
    "RUNTIME_RECONCILIATION",
    "SAFE_ROLLBACK_OR_ROLL_FORWARD",
    "WHOLE_SYSTEM_RED_TEAM",
    "REOPEN_INVALIDATED_CHECKPOINT",
    "REITERATE_TO_NEXT_HIGHEST_VALUE_REQUIREMENT"
  ],
  "forbidden_unsolicited_interruptions": [
    "PROGRESS_UPDATE",
    "PERCENT_COMPLETE",
    "CHECKPOINT_PASS",
    "SUCCESSFUL_TEST",
    "SUCCESSFUL_DEPLOYMENT",
    "SUCCESSFUL_MIGRATION",
    "PR_READY_FOR_REVIEW",
    "PR_READY_FOR_MERGE",
    "PR_CREATION_APPROVAL_REQUEST",
    "PR_BODY_UPDATE_APPROVAL_REQUEST",
    "CONTROL_PLANE_COMMENT_APPROVAL_REQUEST",
    "ROUTINE_MERGE_APPROVAL_REQUEST",
    "ROUTINE_DEPLOYMENT_APPROVAL_REQUEST",
    "ROUTINE_IMPLEMENTATION_CHOICE",
    "RECOVERABLE_FAILURE",
    "DEBUGGING_PROGRESS",
    "SOURCE_SYNC_STATUS",
    "MODEL_RUN_STATUS",
    "REITERATION_STATUS",
    "INVARIANT_CHECK_STATUS",
    "RUNTIME_RECONCILIATION_STATUS",
    "STALE_HISTORICAL_SCOPE_CONFLICT",
    "REQUEST_TO_PROCEED",
    "REQUEST_TO_RECONFIRM_EXISTING_AUTHORITY"
  ],
  "checkpoint_behavior": {
    "on_pass": [
      "VERIFY",
      "VERIFY_AFFECTED_PRODUCT_INVARIANTS",
      "PERSIST_EVIDENCE",
      "PERFORM_NEXT_SAFE_AUTHORIZED_ACTION",
      "WHOLE_SYSTEM_RED_TEAM",
      "REITERATE_IF_SCOPE_REMAINS",
      "CONTINUE_IF_EXECUTION_SURFACE_ACTIVE"
    ],
    "requires_user_acknowledgement": false,
    "emit_status_message": false
  },
  "completion_policy": {
    "code_written_is_done": false,
    "pr_opened_is_done": false,
    "pr_ready_is_done": false,
    "ci_passed_is_done": false,
    "deployment_ready_is_done": false,
    "checkpoint_reached_is_done": false,
    "p0_fixed_is_done": false,
    "done_requires_active_task_acceptance_criteria_satisfied": true,
    "done_requires_all_affected_product_invariants_pass": true,
    "done_requires_no_known_contradictory_evidence": true,
    "done_requires_latest_whole_system_red_team_clear_of_material_go_live_blockers": true
  },
  "failure_behavior": {
    "recoverable_failure": "REMEDIATE_AND_CONTINUE",
    "consequential_unknown": "FAIL_CLOSED",
    "invariant_failure": "REPAIR_OR_SAFE_ROLLBACK_AND_CONTINUE",
    "post_deploy_reconciliation_failure": "REPAIR_OR_SAFE_ROLLBACK_AND_REVERIFY",
    "stale_historical_scope_conflict": "IGNORE_LOWER_PRECEDENCE_ARTIFACT_AND_CONTINUE",
    "escalate_only_if_stop_condition": true,
    "bundle_unresolved_questions": true,
    "base_branch_drift": "REPAIR_AND_CONTINUE"
  },
  "user_requested_query_behavior": {
    "answer_direct_question": true,
    "request_permission_to_resume_after_answer": false,
    "claim_cross_response_continuation_in_ordinary_chat": false
  },
  "allowed_unsolicited_message_prefixes": [
    "BLOCKED",
    "APPROVAL REQUIRED",
    "HUMAN ACTION REQUIRED",
    "DONE"
  ],
  "control_plane": {
    "product_contract": "SPEC.md",
    "agent_contract": "AGENTS.md",
    "manifest": "SPEC_MANIFEST.json",
    "scope_authority_contract": "contracts/scope_authority.v1.json",
    "scope_authority_document": "docs/SCOPE_AUTHORITY.md",
    "product_invariants": "contracts/product_invariants.v1.json",
    "iteration_contract": "docs/ITERATION_CONTRACT.md",
    "delivery_assurance_contract": "docs/DELIVERY_ASSURANCE_CONTRACT.md",
    "checkpoint_evidence": "GitHub issue/control board",
    "runtime_state": "PostgreSQL/Supabase",
    "verification": "CI/evals"
  }
}
